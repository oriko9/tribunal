# Template for .env.local — copy it, then fill in what you need:
#
#     cp .env.local.example .env.local
#
# .env.local is ignored by git and is loaded automatically by `npm run
# tribunal` and `npm run smoke`. Never put a real key in this template: this
# file is committed, and .env.local is the only place a key belongs.

# The OpenRouter API key. Server side only: it is read here, used in one
# Authorization header, and never written to a run file, logged, or sent to a
# browser. Leave it empty to stay on the mock.
OPENROUTER_API_KEY=

# Which provider runs the seven calls.
#   mock       synthetic replies, no network, nothing spent. The default.
#   openrouter live calls against real models, real money.
# A live run is refused at startup if the key is missing or if the run
# configuration still leaves any seat at MODEL_ID_TBD.
TRIBUNAL_PROVIDER=mock

# Deliberate failures, injected into the mock so the failure path can be
# exercised without waiting for a model to misbehave. Comma separated,
# agent=fault[:argument]. Faults: invalid_json, missing_field[:field],
# illegal_verdict[:value], empty, fenced_json, declared_refusal,
# transport_error. An unknown agent id or fault kind is a fatal error.
# Example: TRIBUNAL_MOCK_FAULTS=jon_snow=invalid_json,judge_barak_model=empty
TRIBUNAL_MOCK_FAULTS=

# How long one live call may take, in milliseconds. Default 120000.
# Ignored by the mock.
TRIBUNAL_TIMEOUT_MS=
